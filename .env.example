# SQLite filename for local development. Containers: /data/app.db (mount /data).
DATABASE_URL=local.db

# Project URL or operator contact sent as RSSReader/1.0 (+<contact>).
# Defaults to https://github.com/fluid-movement/rss-reader when unset or blank.
RSS_READER_CONTACT="https://github.com/fluid-movement/rss-reader"

# Exact public base URL, no path. Coolify: https://reader.example.com
# Local Docker Compose: http://localhost:5311
ORIGIN="http://localhost:5311"

# Better Auth
# At least 32 high-entropy characters; generate with: openssl rand -hex 32
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""

# Retention is a per-user database setting (default 30 days), not an env var.
